  "icons": [
    { "src": "mr-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "mr-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "mr-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Targets", "url": "/master-register.html?go=targets", "icons": [{ "src": "mr-icon-192.png", "sizes": "192x192" }] },
    { "name": "New entry", "url": "/master-register.html?go=new", "icons": [{ "src": "mr-icon-192.png", "sizes": "192x192" }] }
  ]
}
